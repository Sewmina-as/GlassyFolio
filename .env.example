# =============================================================================
# Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# These are OPTIONAL — the template works without them.

# Contact Form — Add your email service API key to enable the contact form
# Supported: Resend, SendGrid, or any REST-based email API
# CONTACT_API_KEY=your_api_key_here
# CONTACT_TO_EMAIL=your@email.com

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (used for OG images and canonical URLs)
# NEXT_PUBLIC_SITE_URL=https://yoursite.com
